# Copy to .env.local. Both .env and .env.local are gitignored.
#
# Local development
# -----------------
#   1. Start Docker Desktop.
#   2. npx supabase start
#   3. Copy the "DB URL" it prints into DATABASE_URL below.
#
# The local values are identical for every Supabase project, so they are not
# secrets. The default is what `supabase start` uses unless config.toml changes
# the port.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Production: set this in the Vercel project rather than here, using the
# connection-pooler URL from the Supabase dashboard.
