            "parameter": null,
            "mechanics": []
        },
        {
            "name": "Death Vision of Sanguinius",
            "legend": "",
            "description": "If this model is destroyed by a melee attack, after the attacking unit has finished making its attacks, you can roll one D6, adding 2 to the result if the attacking unit contains the enemy <span class=\"kwb\">WARLORD</span>: on a 2-3, that enemy unit suffers 3 mortal wounds; on a 4-5, that enemy unit suffers D3+3 mortal wounds; on a 6+, that enemy unit suffers D6+3 mortal wounds.",
            "type": "Datasheet",
            "parameter": null,
            "mechanics": []
        },
