                "raw": [
                    {
                        "datasheetId": "000002103",
                        "line": 1,
                        "button": "•",
                        "description": "Any number of models can each have their bolt pistol replaced with one of the following:<ul><li>1 hand flamer</li><li>1 grav-pistol</li><li>1 inferno pistol</li><li>1 plasma pistol</li></ul>"
                    },
                    {
                        "datasheetId": "000002103",
                        "line": 2,
                        "button": "•",
                        "description": "Any number of Company Veterans can each have their bolt pistol replaced with 1 Astartes shield."
                    },
                    {
                        "datasheetId": "000002103",
                        "line": 3,
                        "button": "•",
                        "description": "Any number of Company Veterans can each have  their bolt pistol and boltgun replaced with 1 twin lightning claws."
                    },
                    {
