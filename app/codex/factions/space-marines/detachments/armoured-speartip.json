    "id": "000001147",
    "slug": "armoured-speartip",
    "name": "Armoured Speartip",
    "abilities": [
        {
            "id": "000010777",
            "name": "Rapid Deployment",
            "description": "Each time an <span class=\"kwb\">ADEPTUS</span> <span class=\"kwb\">ASTARTES</span> unit from your army disembarks from a Transport (excluding Fly) that made a Normal or Advance move this phase (excluding those that arrived from Strategic Reserves), that disembarked unit can make a Normal move of up to D6\", or a Normal move of up to D3+3\" instead if that <span class=\"kwb\">TRANSPORT</span> is a Heavy Transport (see below).<br><br><span class=\"hi_custom\">Keywords</span><br>Adeptus Astartes Transport units from your army (excluding Fly) that have a Wounds characteristic of 14+ have the <span class=\"kwb\">HEAVY</span> <span class=\"kwb\">TRANSPORT</span> keyword.",
            "legend": "Land Raider, Repulsors and other armoured transports plunge headlong into the heart of enemy formations, weathering heavy firepower to deploy their cargo of elite Space Marines into battle.",
            "eligibleDatasheets": {
                "exclude": [
                    "000003875"
                ]
            }
        }
    ],
    "stratagems": [
        {
            "id": "000010780007",
            "name": "PURGATION DOCTRINE",
            "type": "Battle Tactic",
            "cpCost": 1,
            "legend": "Emerging from their transports, Space Marine infantry ruthlessly clear enemy positions.",
            "turn": "Your turn",
            "phase": "Shooting phase",
            "description": "<b>WHEN:</b> Your Shooting phase.<br><br><b>TARGET:</b> One <span class=\"kwb\">ADEPTUS</span> <span class=\"kwb\">ASTARTES</span> unit from your army that has not been selected to shoot this phase.<br><br><b>EFFECT:</b> Until the end of the phase, each time a model in your unit makes an attack, add 1 to the Hit roll (if your unit disembarked from a Heavy Transport this turn, add 1 to the Wound roll as well).",
            "eligibleDatasheets": {
                "exclude": [
                    "000003875"
                ]
            }
        },
        {
            "id": "000010780002",
            "name": "MACHINE WRATH",
            "type": "Epic Deed",
            "cpCost": 1,
            "legend": "In a last act of vengeance, the doomed crew of this burning transport drive into the midst of the enemy.",
            "turn": "Either player’s turn",
            "phase": "Any phase",
            "description": "<b>WHEN:</b> Any phase, just after a Heavy Transport unit from your army with the Deadly Demise ability is destroyed.<br><br><b>TARGET:</b> That <span class=\"kwb\">HEAVY</span> <span class=\"kwb\">TRANSPORT</span> unit, if you rolled a 6 for its Deadly Demise ability. You can use this Stratagem on that unit even though it was just destroyed.<br><br><b>EFFECT:</b> Your unit can make a Normal or Fall Back move before its Deadly Demise ability is resolved, and before any embarked units perform an Emergency Disembarkation. When making this move, your unit can move through enemy models (excluding <span class=\"kwb\">MONSTERS</span> and <span class=\"kwb\">VEHICLES</span>) and can move within Engagement Range of such models, but cannot end that move within Engagement Range of them, and any Desperate Escape test is automatically passed.",
