    "stratagems": [
        {
            "id": "000010161005",
            "name": "TACTICAL MASTERY",
            "type": "Battle Tactic",
            "cpCost": 1,
            "legend": "When the constituent elements of the Dark Angels fight as one, the enemy is often overwhelmed and torn apart by the fluidity of the Chapter’s rapid advances, tactical withdrawals and unexpected counteroffensives.",
            "turn": "Your turn",
            "phase": "Movement phase",
            "description": "<b>WHEN:</b> Your Movement phase.<br><br><b>TARGET:</b> One <span class=\"kwb\">ADEPTUS</span> <span class=\"kwb\">ASTARTES</span> unit from your army.<br><br><b>EFFECT:</b> Until the end of the turn, your unit is eligible to shoot and declare a charge in a turn in which it Advanced. If your unit has the Ravenwing keyword, it is also eligible to shoot and declare a charge in a turn in which it Fell Back.",
            "eligibleDatasheets": {
                "exclude": [
                    "000003875"
                ]
            }
        },
        {
            "id": "000010161004",
            "name": "ARMOUR OF CONTEMPT",
            "type": "Battle Tactic",
            "cpCost": 1,
            "legend": "The belligerence of the Adeptus Astartes combined with their transhuman physiology makes them unyielding foes to face.",
            "turn": "Either player’s turn",
            "phase": "Shooting or Fight phase",
            "description": "<b>WHEN:</b> Your opponent’s Shooting phase or the Fight phase, just after an enemy unit has selected its targets.<br><br><b>TARGET:</b> One <span class=\"kwb\">ADEPTUS</span> <span class=\"kwb\">ASTARTES</span> unit from your army that was selected as the target of one or more of the attacking unit’s attacks.<br><br><b>EFFECT:</b> Until the attacking unit has finished making its attacks, each time an attack targets your unit, worsen the Armour Penetration characteristic of that attack by 1.",
            "eligibleDatasheets": {
                "exclude": [
                    "000003875"
                ]
            }
        },
