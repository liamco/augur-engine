    "name": "Hammer of Avernii",
    "abilities": [
        {
            "id": "000010620",
            "name": "Calculated Annihilation",
            "description": "Each time a model from your army with the Oath of Moment ability makes an attack that targets your Oath of Moment target, you can re-roll a Wound roll of 1.",
            "legend": "Heavily enhanced with augmetics and the weight of many years of combat experience to aid them, the veteran warriors of Clan Company Avernii ruthlessly select and destroy their targets.",
            "eligibleDatasheets": {
                "exclude": [
                    "000003875"
                ]
            }
        },
        {
            "id": "000010621",
            "name": "Recalculating",
            "description": "Once per battle round, after your Oath of Moment target is destroyed, if a Caanok Var model from your army is on the battlefield, select one enemy unit visible to that model. That enemy unit becomes your Oath of Moment target until you select a new one.",
            "legend": "Caanok Var ensures every bolt shell is directed where it serves the greatest purpose.",
            "eligibleDatasheets": {
                "exclude": [
                    "000003875"
                ]
            }
        },
        {
            "id": "000010622",
            "name": "Restrictions",
            "description": "Your army can include Iron Hands units, but it cannot include any <span class=\"kwb\">ADEPTUS</span> <span class=\"kwb\">ASTARTES</span> units drawn from any other Chapter.",
            "legend": "Caanok Var ensures every bolt shell is directed where it serves the greatest purpose.",
            "eligibleDatasheets": {
                "include": []
            }
        }
    ],
    "stratagems": [
        {
            "id": "000010624002",
            "name": "ARMOUR OF CONTEMPT",
            "type": "Battle Tactic",
            "cpCost": 1,
            "legend": "The belligerence of the Adeptus Astartes combined with their post-human physiology makes them unyielding foes to face.",
            "turn": "Either player’s turn",
            "phase": "Shooting or Fight phase",
            "description": "<b>WHEN:</b> Your opponent’s Shooting phase or the Fight phase, just after an enemy unit has selected its targets.<br><br><b>TARGET:</b> One <span class=\"kwb\">ADEPTUS</span> <span class=\"kwb\">ASTARTES</span> unit from your army that was selected as the target of one or more of the attacking unit’s attacks.<br><br><b>EFFECT:</b> Until the attacking unit has finished making its attacks, each time an attack targets your unit, worsen the Armour Penetration characteristic of that attack by 1.",
            "eligibleDatasheets": {
                "exclude": [
                    "000003875"
                ]
            }
        },
