    "stratagems": [
        {
            "id": "000010760004",
            "name": "ARMOUR OF CONTEMPT",
            "type": "Battle Tactic",
            "cpCost": 1,
            "legend": "The belligerence of the Adeptus Astartes combined with their post-human physiology makes them unyielding foes to face.",
            "turn": "Either player’s turn",
            "phase": "Shooting or Fight phase",
            "description": "<b>WHEN:</b> Your opponent’s Shooting phase or the Fight phase, just after an enemy unit has selected its targets.<br><br><b>TARGET:</b> One <span class=\"kwb\">ADEPTUS</span> <span class=\"kwb\">ASTARTES</span> unit from your army that was selected as the target of one or more of the attacking unit’s attacks.<br><br><b>EFFECT:</b> Until the attacking unit has finished making its attacks, each time an attack targets your unit, worsen the Armour Penetration characteristic of that attack by 1.",
            "eligibleDatasheets": {
                "exclude": [
                    "000003875"
                ]
            }
        },
        {
            "id": "000010760006",
            "name": "AUGMENTED TARGETING",
            "type": "Battle Tactic",
            "cpCost": 1,
            "legend": "Auto-sense targeting subroutines specially adapted for defensive fire patterns aid these warriors’ aim.",
            "turn": "Your turn",
            "phase": "Shooting phase",
            "description": "<b>WHEN:</b> Your Shooting phase.<br><br><b>TARGET:</b> One <span class=\"kwb\">ADEPTUS</span> <span class=\"kwb\">ASTARTES</span> unit from your army that has not been selected to shoot this phase.<br><br><b>EFFECT:</b> Select either the [SUSTAINED HITS 1] or [LETHAL HITS] abilities. Until the end of the phase, ranged weapons equipped by models in your unit have the selected ability. If your unit is <span class=\"kwb\">ENTRENCHED</span>, until the end of the phase, ranged weapons equipped by models in your unit have the [SUSTAINED HITS 1] and [LETHAL HITS] abilities instead.",
            "eligibleDatasheets": {
                "exclude": [
                    "000003875"
                ]
            }
        },
