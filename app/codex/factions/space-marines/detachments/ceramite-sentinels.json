    "name": "Ceramite Sentinels",
    "abilities": [
        {
            "id": "000010758",
            "name": "Adaptive Defence",
            "description": "Each time an <span class=\"kwb\">ADEPTUS</span> <span class=\"kwb\">ASTARTES</span> model from your army makes an attack, if that model’s unit is within a terrain feature, re-roll a Hit roll of 1 and re-roll a Wound roll of 1.<br><br><span class=\"kwb\">ADEPTUS</span> <span class=\"kwb\">ASTARTES</span> units from your army gain the <span class=\"kwb\">ENTRENCHED</span> keyword while all of the following are true:<br><ul><li>That unit is within a terrain feature.</li><li>That unit was not set up on the battlefield this turn.</li><li>No model in that unit has moved more than 3\" this turn.</li></ul>",
            "legend": "These Space Marines are experts in fighting from rapidly prepared defensive positions. They are able to maximise the potential of almost any terrain to serve as an ad-hoc strongpoint, rapidly assessing optimal firing lines and punishing the foe’s every attempt to advance and dislodge them.",
            "mechanics": [
                {
                    "name": "Adaptive Defence",
                    "entity": "thisUnit",
                    "effect": "reroll",
                    "attribute": "hit",
                    "value": 1
                },
                {
