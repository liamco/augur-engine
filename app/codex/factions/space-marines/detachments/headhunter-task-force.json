        {
            "id": "000010784005",
            "name": "RAPID GUNNERY",
            "type": "Strategic Ploy",
            "cpCost": 1,
            "legend": "Advanced targeting systems and the skill of transhuman gunners ensure that Space Marine tanks keep up a punishing rate of fire, even when extracting themselves from a press of enemies.",
